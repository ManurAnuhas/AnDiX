# Discord Bot Configuration
# ඔයාගේ Discord Developer Portal එකෙන් ලැබෙන Bot Token එක මෙතනට දාන්න:
DISCORD_TOKEN=your_bot_token_here

# ඔයාගේ Application ID (Client ID) එක මෙතනට දාන්න:
CLIENT_ID=your_client_id_here

# Slash Commands ඉක්මනින් Server එකට Update වෙන්න ඔයාගේ Discord Server ID එක මෙතනට දාන්න (Optional):
GUILD_ID=

# Master Admin Credentials (For SaaS Owner Dashboard)
ADMIN_EMAIL=admin@andix.bot
ADMIN_PASSWORD=admin123

# JWT Secret for Client Authentication Sessions
JWT_SECRET=andix_secure_jwt_token_key_2026

# Free Cloud Database (MongoDB Atlas URI - Optional for Vercel deployment)
MONGODB_URI=

